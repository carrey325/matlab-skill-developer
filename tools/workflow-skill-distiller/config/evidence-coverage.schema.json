{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "dimensions"],
  "properties": {"schema_version": {"const": "1.1.0"}, "workflow_id": {"type": "string"}, "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}}},
  "$defs": {"dimension": {"type": "object", "additionalProperties": false, "required": ["id", "name", "requirement", "condition", "atom_ids", "source_ids", "authority_levels", "applicability", "status", "unresolved_gap", "analysis_notes"], "properties": {"id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}, "name": {"type": "string"}, "requirement": {"enum": ["required", "conditional"]}, "condition": {"type": ["string", "null"]}, "atom_ids": {"type": "array", "items": {"type": "string"}}, "source_ids": {"type": "array", "items": {"type": "string"}}, "authority_levels": {"type": "array", "items": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6"]}}, "applicability": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "status": {"enum": ["covered", "weak", "gap", "not_applicable"]}, "unresolved_gap": {"type": ["string", "null"]}, "analysis_notes": {"type": "string", "minLength": 10}}}}
}
