{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "build_method", "semantic_authoring_id", "review_cycle", "status"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "workflow_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-workflow$"},
    "build_method": {"const": "individual-professional-deepening"},
    "semantic_authoring_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "review_cycle": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["SYNTHESIS", "REVIEW", "RELEASED", "HUMAN_REVIEW"]},
    "generated_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
