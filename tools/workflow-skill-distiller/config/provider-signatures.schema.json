{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "signatures"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "provider": {"type": "string", "minLength": 1},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "skill_sha256", "evidence_state", "description", "methods", "capabilities"],
      "properties": {
        "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_state": {"enum": ["inspected", "uninspected"]},
        "description": {"type": "string"},
        "methods": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
