{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reviewer", "status", "cycle", "checks", "defects", "required_changes"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "reviewer": {"type": "string"}, "status": {"enum": ["PASS", "RESEARCH_MORE", "RESYNTHESIZE", "REGENERATE", "REGRANULARIZE"]}, "cycle": {"type": "integer", "minimum": 1},
    "return_to_stage": {"enum": [1, 2, 3, 5]}, "post_alignment_return_stage": {"const": 2}, "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "defects": {"type": "array", "items": {"type": "string"}}, "required_changes": {"type": "array", "items": {"type": "string"}}, "human_review_required": {"type": "boolean"}
  },
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "status", "notes", "evidence"],
      "properties": {
        "dimension": {"type": "string"},
        "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
        "notes": {"type": "string", "minLength": 10},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
