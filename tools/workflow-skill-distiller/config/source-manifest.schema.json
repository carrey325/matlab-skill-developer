{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "sources"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "workflow_id": {"type": "string"},
    "source_library": {"$ref": "#/$defs/source_library"},
    "sources": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/source"}, {"$ref": "#/$defs/source_ref"}]}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "organization", "title", "version", "url", "source_type", "publication_date", "jurisdiction", "authority_tier", "official_primary", "status", "retrieved_at", "sha256", "raw_path", "normalized_path", "normalization"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"},
        "organization": {"type": "string", "minLength": 2},
        "title": {"type": "string", "minLength": 5},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "source_type": {"enum": ["primary_standard_or_regulation", "supervisory_guidance", "banking_architecture_or_business_process", "established_academic_or_practitioner", "vendor_documentation_or_examples"]},
        "publication_date": {"type": "string", "minLength": 4},
        "effective_date": {"type": ["string", "null"]},
        "jurisdiction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authority_tier": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6"]},
        "official_primary": {"type": "boolean"},
        "status": {"enum": ["current", "historical", "superseded", "consultative"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "raw_path": {"type": "string", "pattern": "^sources/raw/"},
        "normalized_path": {"type": "string", "pattern": "^sources/normalized/"},
        "normalization": {"$ref": "#/$defs/normalization"}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"}
      }
    },
    "source_library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library_id", "manifest_path"],
      "properties": {
        "library_id": {"const": "risk-evidence-library"},
        "manifest_path": {"type": "string", "pattern": "^risk-evidence-library/manifest/sources\\.yaml$"}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text_characters", "heading_count", "duplicate_of", "quality_flags"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed", "manual_review"]},
        "text_characters": {"type": "integer", "minimum": 0},
        "heading_count": {"type": "integer", "minimum": 0},
        "duplicate_of": {"type": ["string", "null"]},
        "quality_flags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
