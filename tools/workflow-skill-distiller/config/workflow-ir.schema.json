{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-ir.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workflow", "inputs", "outputs", "domain_knowledge", "inferences", "tasks", "control_flow", "decisions", "validation_gates", "exceptions", "recovery_paths", "stop_conditions", "capability_requirements", "evidence_map"],
  "properties": {
    "schema_version": {"const": "1.1.0"}, "workflow": {"$ref": "#/$defs/workflow"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/named"}}, "outputs": {"type": "array", "items": {"$ref": "#/$defs/named"}},
    "domain_knowledge": {"type": "array", "items": {"$ref": "#/$defs/domain"}}, "inferences": {"type": "array", "items": {"$ref": "#/$defs/inference"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}, "control_flow": {"$ref": "#/$defs/control_flow"},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}}, "validation_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/route"}}, "recovery_paths": {"type": "array", "items": {"$ref": "#/$defs/route"}}, "stop_conditions": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "capability_requirements": {"type": "array", "items": {"$ref": "#/$defs/capability"}}, "evidence_map": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "workflow": {"type": "object", "additionalProperties": false, "required": ["id", "version", "purpose", "scope", "exclusions", "trigger", "not_for"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-workflow$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "purpose": {"type": "string", "minLength": 20}, "scope": {"type": "string", "minLength": 20}, "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "trigger": {"type": "string", "minLength": 20}, "not_for": {"type": "string", "minLength": 20}}},
    "named": {"type": "object", "additionalProperties": false, "required": ["name", "description"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["id", "name", "definition", "evidence"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "name": {"type": "string"}, "definition": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "inference": {"type": "object", "additionalProperties": false, "required": ["id", "operation", "objective", "evidence"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "operation": {"enum": ["define", "assess", "prepare", "classify", "estimate", "compare", "validate", "diagnose", "select", "project", "aggregate", "attribute", "stress", "report"]}, "objective": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "title", "parent", "objective", "inputs", "outputs", "inferences", "decision_ids", "leaf", "mandatory", "evidence"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string"}, "parent": {"type": ["string", "null"]}, "objective": {"type": "string"}, "inputs": {"type": "array", "items": {"type": "string"}}, "outputs": {"type": "array", "items": {"type": "string"}}, "inferences": {"type": "array", "items": {"type": "string"}}, "decision_ids": {"type": "array", "items": {"type": "string"}}, "leaf": {"type": "boolean"}, "mandatory": {"type": "boolean"}, "completion_criteria": {"type": "array", "items": {"type": "string"}}, "capability_ids": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "control_flow": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "type": {"enum": ["start", "end", "task", "decision", "validation_gate", "parallel_split", "join", "recovery", "stop"]}, "title": {"type": "string"}, "task_id": {"type": "string"}, "decision_id": {"type": "string"}, "gate_id": {"type": "string"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "condition": {"type": "string"}, "outcome": {"type": "string"}, "default": {"type": "boolean"}}},
    "decision_input": {"type": "object", "additionalProperties": false, "required": ["name", "description", "required"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "required": {"type": "boolean"}, "producer": {"enum": ["request", "policy", "source-evidence", "prior-task", "measured-output"]}, "observable": {"type": "boolean"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["input", "operator", "value"], "properties": {"input": {"type": "string"}, "operator": {"enum": ["equals", "not_equals", "in", "not_in", "present", "missing", "less_than", "less_or_equal", "greater_than", "greater_or_equal", "contains", "not_contains"]}, "value": {}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["id", "conditions", "outcome", "rationale", "applicability", "exclusions", "missing_information_behavior", "evidence"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}, "outcome": {"type": "string"}, "rationale": {"type": "string", "minLength": 10}, "applicability": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}}, "missing_information_behavior": {"type": "string", "minLength": 10}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["outcome", "instruction"], "properties": {"outcome": {"type": "string"}, "instruction": {"type": "string", "minLength": 10}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "title", "purpose", "inputs", "rules", "fallback", "evidence"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string"}, "purpose": {"type": "string", "minLength": 10}, "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision_input"}}, "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}, "fallback": {"$ref": "#/$defs/fallback"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "gate_outcome": {"type": "object", "additionalProperties": false, "required": ["name", "criteria", "route", "evidence"], "properties": {"name": {"enum": ["PASS", "PASS_WITH_LIMITATION", "REMEDIATE", "REJECT"]}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "route": {"type": "string", "minLength": 5}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["id", "title", "purpose", "required_evidence", "assessment_dimensions", "acceptance_policy", "outcomes", "applicability", "evidence"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string"}, "purpose": {"type": "string", "minLength": 10}, "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "assessment_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptance_policy": {"type": "string", "minLength": 20}, "outcomes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/gate_outcome"}}, "applicability": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "condition", "instruction", "target_node"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "condition": {"type": "string"}, "instruction": {"type": "string", "minLength": 10}, "target_node": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "task_ids"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "kind": {"enum": ["reasoning", "computational", "data_access", "reporting"]}, "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["claim_id", "claim", "atom_ids"], "properties": {"claim_id": {"type": "string"}, "claim": {"type": "string", "minLength": 10}, "atom_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
